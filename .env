# 流程图工具箱 环境变量模板
# 复制为 .env 后按需修改。
# 敏感值（密码、secret）必须加密为 ENC(...) 后再提交 git；明文仅可留在本机未跟踪文件。
# Python: scaffold/scripts/secret.py | Java: Jasypt（见 backend AGENTS.md）
# 解密密钥: 环境变量 CONFIG_KEY（勿写入本文件）
#
# docker compose 还会加载 backend/.env：
#   - Python：DATABASE__URL / REDIS__URL / MINIO__* / AUTH__*（生产主机名为 postgres/redis/minio）
#   - Java：JDBC_PASSWORD / REDIS_PASSWORD 等（主机名在 application.yml）
# 共用 infra 时口令必须与 jxaiqtc-infra 实际值一致（默认占位符可能对不上）。

APP_NAME=flowchart-toolbox
APP_TAG=latest
INFRA_NET=infra-net

# 数据库（共用中间件时：连已有 PG，用 DB_NAME 做项目隔离）
DB_NAME=flowchart_toolbox_db
DB_USER=flowchart_toolbox_user
DB_PASSWORD=ENC(gAAAAABqer9gABXLJAJhosLy1XRzWbShvFQOc2PtjWRglbT0yyokuv9AOwuGBJQ4CZ36EF3YXNP1DU8DXorYIySj8RSyvRZx-uNmC-tp9oLbS3skpnpSrus=)
DB_PORT=5432
JDBC_PASSWORD=ENC(gAAAAABqer9gABXLJAJhosLy1XRzWbShvFQOc2PtjWRglbT0yyokuv9AOwuGBJQ4CZ36EF3YXNP1DU8DXorYIySj8RSyvRZx-uNmC-tp9oLbS3skpnpSrus=)

# Redis（多项目共用实例，靠应用侧 key 前缀隔离；口令对齐共用中间件）
REDIS_PASSWORD=ENC(gAAAAABqer9gMnIdZTM8gbguGLUXezu9hJHQ-VALxbj4CadQSTQY7ArKkDi0uUTvFkAIArYAZle8HII4UZBj-M6qoO-fAe9jIA==)
REDIS_PORT=6379

# MinIO（多项目共用实例，建议按项目分 bucket）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=minio
MINIO_PASSWORD=ENC(gAAAAABqer9gmaGInHc93FxAb8QkVLonPHAuEr8Oh5kpQJrPKID7COFEv-r4ISo2gDyIEBetj08pZVtnowkOjknVw-Cl9lfE_A==)

# 端口
# BACKEND_PORT / APP_PORT：宿主机访问与 compose 映射左侧（默认与容器内一致）
# 容器内监听固定：Java 8080 / Python 8000（compose 右侧 CONTAINER_PORT，勿当应用配置改）
APP_PORT=10105
BACKEND_PORT=10105
FRONTEND_PORT=20105

# 认证（Java / compose 用单下划线；Python 读 backend/.env 的 AUTH__*）
AUTH_ENABLED=true
CAPTCHA_ENABLED=false
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
