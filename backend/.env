# ============================================
# 生产基线配置（Docker 服务名；本地用 .env.local 覆盖为 localhost）
# 层叠机制：.env → .env.{APP_ENV} → 运行时环境变量
# 嵌套键用 __ 分隔（如 DATABASE__URL → settings.database.url）
# ============================================

# Docker Compose 变量（docker-compose.yml 使用；APP_PORT=宿主机映射，容器内固定 8000）
APP_NAME=flowchart-toolbox-server
APP_TAG=latest
APP_PORT=10105
INFRA_NET=infra-net

# 应用配置（容器内 / 生产基线固定 APP__PORT=8000；本机改口写 .env.local）
APP__DEBUG=false
APP__JSON_CAMEL_CASE=true
APP__PORT=10105
APP__NAME=flowchart-toolbox

# 数据库（业务账号；超管 app 仅用于建库建用户；生产连 infra-net 内 postgres）
DATABASE__URL=postgresql://flowchart_toolbox_user:ENC(gAAAAABqer9gABXLJAJhosLy1XRzWbShvFQOc2PtjWRglbT0yyokuv9AOwuGBJQ4CZ36EF3YXNP1DU8DXorYIySj8RSyvRZx-uNmC-tp9oLbS3skpnpSrus=)@postgres:5432/flowchart_toolbox_db
DATABASE__ECHO=false
DATABASE__POOL_SIZE=20
DATABASE__AUTO_MIGRATE=false

# 日志
LOG__LEVEL=INFO
LOG__DIR=logs/
LOG__TYPES=console

# 认证
AUTH__ENABLED=true
AUTH__CAPTCHA_ENABLED=false
AUTH__SSO__ENABLED=false
AUTH__SSO__ISSUER=
AUTH__SSO__CLIENT_ID=
AUTH__SSO__CLIENT_SECRET=
AUTH__SSO__REDIRECT_URI=
AUTH__SSO__FRONTEND_CALLBACK=http://localhost:20105/#/sso-callback

# Redis（生产连 infra-net 内 redis；口令须与共用中间件实际值一致）
REDIS__URL=redis://:ENC(gAAAAABqer9gMnIdZTM8gbguGLUXezu9hJHQ-VALxbj4CadQSTQY7ArKkDi0uUTvFkAIArYAZle8HII4UZBj-M6qoO-fAe9jIA==)@redis:6379/0

# MinIO（生产连 infra-net 内 minio）
MINIO__ENDPOINT=minio:9000
MINIO__ACCESS_KEY=minio
MINIO__SECRET_KEY=ENC(gAAAAABqer9gmaGInHc93FxAb8QkVLonPHAuEr8Oh5kpQJrPKID7COFEv-r4ISo2gDyIEBetj08pZVtnowkOjknVw-Cl9lfE_A==)
MINIO__SECURE=false
