# Copy this file to docker-compose.local.env, then set unique local-only values.
# docker-compose.local.env is ignored by Git and must never be committed.
# Use URI-safe characters in LOCAL_POSTGRES_PASSWORD because the same value is
# used in DATABASE__URL. Prefer letters, digits, hyphens, and underscores.
LOCAL_POSTGRES_DB=
LOCAL_POSTGRES_USER=
LOCAL_POSTGRES_PASSWORD=
LOCAL_MINIO_ROOT_USER=
LOCAL_MINIO_ROOT_PASSWORD=
# Optional host ports. Leave blank to use the documented local defaults.
LOCAL_POSTGRES_PORT=
LOCAL_REDIS_PORT=
LOCAL_MINIO_API_PORT=
LOCAL_MINIO_CONSOLE_PORT=
LOCAL_BACKEND_PORT=
LOCAL_FRONTEND_PORT=
